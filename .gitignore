# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/

# 环境变量（含 API Key，严禁提交）
.env
.env.local
.env.llm

# 生成产物
data/*.db
data/traces/
# data/report/ 默认忽略，但保留关键执行记录入库（评委可审计 mock 轨道的
# 「框架回归基线」结果与真实 LLM 轨道的主评测口径）：
data/report/*
!data/report/metrics.json
!data/report/metrics_round1.json
!data/report/metrics_llm.json
!data/report/metrics_llm_legacy.json
!data/report/report.html
!data/report/llm_track.md
!data/report/llm_track_legacy.md
!data/report/llm_rounds.md
!data/report/extra_security.json
data/uploads/

# 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# testsuite/verify_cases.py 的验证用 trace 输出（工具产物，不入库）
data/traces_verify/

# 目录穿越探针（tests/test_trace_security.py 生成；沙箱 trash 失败时可能残留）
data/TRAVERSAL_PROBE.jsonl

# 跨模型矩阵的本地配置（含各家 key 的环境变量名，各人不同，不入库）
models.json

# 本地临时产物（调试日志 / `pytest --basetemp=_tmp_pt` 的临时目录）
_tmp_*
